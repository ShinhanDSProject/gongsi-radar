# ===== 인증 =====
# 두 값을 반드시 다르게 둔다. 같으면 조회 키로 발행을 넣을 수 있게 되므로 서비스가 뜨지 않는다
# 조회 키는 AI 서버(Tool Gateway)가, 시스템 키는 Spring Boot만 갖는다. AI 서버에는 시스템 키를 두지 않는다
CORE_API_KEY=dev-core-read-key
CORE_SYSTEM_KEY=dev-core-system-key

# ===== 시뮬레이션 =====
# 기본은 꺼 둔다. 재시도·타임아웃을 관찰할 때만 올린다
CORE_LATENCY_MS_MIN=0
CORE_LATENCY_MS_MAX=0
CORE_FAIL_RATE=0

# ===== 비즈니스 룰 =====
PUBLICATION_DAILY_LIMIT=20
PUBLICATION_DECISION_TIMEOUT_SEC=86400

# ===== DB =====
CORE_DB_PATH=./data/core.db
