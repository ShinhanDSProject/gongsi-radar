# AI 서버(.env로 복사해 쓴다. .env는 커밋하지 않는다)
AI_SERVER_API_KEY=dev-ai-internal-key

# LLM — openai | ollama | mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# false면 openai LLM과 openai 임베딩이 모두 막힌다(폐쇄망 모드)
ALLOW_EXTERNAL_LLM=true

# RAG — hash(모델 없음, 결정적) | ollama(bge-m3, 폐쇄망) | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
CHROMA_PERSIST_DIR=./data/chroma

# MariaDB — 업무(앱 계정)와 감사(감사 계정)는 반드시 다른 계정
MARIADB_URL=mysql+pymysql://gongsi_app:app-pass@localhost:3307/gongsi?charset=utf8mb4
MARIADB_AUDIT_URL=mysql+pymysql://gongsi_audit:audit-only-pass@localhost:3307/gongsi?charset=utf8mb4

# Core Zone(발행 원장) — 조회 키만. 시스템 키는 두지 않는다
CORE_BASE_URL=http://localhost:9100
CORE_API_KEY=dev-core-read-key

# 통제
AGENT_MAX_ITERATIONS=5
AGENT_MAX_REVISIONS=2
RATE_LIMIT_PER_MIN=120
ENABLE_MODERATION=false

# radar 데이터 소스 — sample(가상 기업) | opendart
RADAR_SOURCE=sample
OPENDART_API_KEY=
DATA_GO_KR_API_KEY=

# #3 일일 수집 — 화면은 적재 DB를 먼저 읽는다(비어 있으면 원천). 읽기는 앱 계정
RADAR_INGEST_DB=mysql+pymysql://gongsi_app:app-pass@localhost:3307/gongsi?charset=utf8mb4
INGEST_DAILY_BUDGET=15000
# 수집 작업(python -m radar ingest daily)만 쓰는 값 — 서버에는 필요 없다. 수집 전용 계정·감사 전용 계정
# RADAR_INGEST_WRITE_DB=mysql+pymysql://gongsi_ingest:ingest-pass@localhost:3307/gongsi?charset=utf8mb4
# RADAR_AUDIT_DB=mysql+pymysql://gongsi_audit:audit-only-pass@localhost:3307/gongsi?charset=utf8mb4
