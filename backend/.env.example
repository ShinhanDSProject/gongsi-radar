# 백엔드 로컬 설정. 이 파일을 backend/.env.local 로 복사해 값을 채운다(.env.local은 git에 올라가지 않는다).
# scripts/dev.sh start 가 백엔드를 띄울 때 읽는다. 직접 ./gradlew bootRun 할 때는 export 하거나 같은 파일을 source 한다.

# 데이터 원천: sample(가상 기업, 키 불필요) | opendart(실제 공시)
GONGSI_DATA_SOURCE=sample

# OpenDART 인증키(https://opendart.fss.or.kr 에서 발급). opendart 모드에서 필요
OPENDART_API_KEY=

# 공공데이터포털 '디코딩' 키(금융위원회 주식시세정보). 없으면 시세·시가총액·PER·PBR이 비어 나온다
DATA_GO_KR_API_KEY=

# 일일 수집 예약(비우면 꺼짐). 공백이 있으니 따옴표로 감싼다. 예: GONGSI_INGEST_CRON="0 30 18 * * MON-FRI"
GONGSI_INGEST_CRON=
